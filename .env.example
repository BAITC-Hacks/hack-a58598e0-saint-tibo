# bun run setup creates .env and a random secret. Root commands inherit these values.
# A second checkout needs its own COMPOSE_PROJECT_NAME, ports and database name.
COMPOSE_PROJECT_NAME=saint_tibo
APP_DOMAIN=localhost
POSTGRES_DB=saint_tibo
POSTGRES_USER=saint_tibo
POSTGRES_PASSWORD=saint_tibo
POSTGRES_PORT=5432
FRONTEND_PORT=3000
BACKEND_PORT=8000
# Explicit dev-only synthetic API (Compose profile mock).
MOCK_API_PORT=8015
AUTH_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
BACKEND_DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
BETTER_AUTH_URL=http://localhost:${FRONTEND_PORT}
BETTER_AUTH_SECRET=
BETTER_AUTH_JWT_AUDIENCE=saint_tibo-api
# Enabled by personal HTTPS dev deployment only; production always forces false.
DEV_LOGIN_ENABLED=false
MOCK_API_ENABLED=false
BACKEND_AUTH_ISSUER=http://localhost:${FRONTEND_PORT}
BACKEND_AUTH_JWKS_URL=http://localhost:${FRONTEND_PORT}/api/auth/jwks
BACKEND_AUTH_AUDIENCE=saint_tibo-api
BACKEND_CORS_ORIGINS=["http://localhost:${FRONTEND_PORT}"]
VITE_API_URL=http://localhost:${BACKEND_PORT}
BACKEND_INTERNAL_URL=http://localhost:${BACKEND_PORT}

# Private local recording files; Docker uses its persistent recordings_data volume.
BACKEND_RECORDING_STORAGE_PATH=../.data/recordings
BACKEND_RECORDING_MAX_BYTES=536870912
BACKEND_RECORDING_CHUNK_MAX_BYTES=8388608
BACKEND_RECORDING_MAX_DURATION_MS=14400000
BACKEND_RECORDING_MAX_CHUNKS=4096
BACKEND_RECORDING_STALE_SECONDS=900
BACKEND_RECORDING_UPLOAD_TIMEOUT_SECONDS=600
BACKEND_RECORDING_MEDIA_TIMEOUT_SECONDS=600
## Self-hosted STT bundle: prepare tools/transcribe/prepare_model.py <path>/small first.
STT_MODELS_PATH=./models
# Container path to an explicitly prepared allowlisted bundle; small remains the default.
BACKEND_STT_MODEL_PATH=/models/small
