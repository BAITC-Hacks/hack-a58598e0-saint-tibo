{
  "name": "frontend",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun --env-file=../.env run --bun vite dev",
    "generate-routes": "tsr generate",
    "build": "bun --env-file=../.env run --bun vite build",
    "preview": "bun --env-file=../.env run --bun vite preview",
    "format": "oxfmt",
    "lint": "oxlint",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "if [ -e ../.git ]; then lefthook install; fi",
    "lint:fix": "oxlint --fix",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "lint:fsd": "steiger src",
    "ui:add": "shadcn add --yes --overwrite",
    "ui:info": "shadcn info",
    "verify": "bun run typecheck && bun run check && bun run lint:fsd && bun run build",
    "generate": "bun run scripts/generate-i18n.ts && tsr generate",
    "seed": "bun run scripts/seed.ts",
    "pretypecheck": "bun run generate",
    "auth:db:generate": "bun --env-file=../.env run --bun drizzle-kit generate --config drizzle.auth.config.ts",
    "auth:db:migrate": "bun --env-file=../.env run --bun drizzle-kit migrate --config drizzle.auth.config.ts",
    "api:generate": "bun install --cwd ../tools/api-client --frozen-lockfile --ignore-scripts && bun run --cwd ../tools/api-client generate",
    "dev:stack": "bun --env-file=../.env run --bun concurrently --kill-others --names api,web \"uv run --directory ../backend uvicorn saint_tibo.main:create_app --factory --reload --port ${BACKEND_PORT:-8000}\" \"bun run dev\"",
    "preview:stack": "bun --env-file=../.env run --bun concurrently --kill-others --names api,web \"uv run --directory ../backend uvicorn saint_tibo.main:create_app --factory --port ${BACKEND_PORT:-8000}\" \"bun run preview\"",
    "i18n:add": "bun run scripts/i18n.ts add",
    "i18n:check": "bun run scripts/i18n.ts check",
    "test": "bun test src",
    "admin:grant": "bun run scripts/seed.ts grant",
    "token": "bun run scripts/token.ts",
    "start": "bun run server.ts",
    "precheck": "bun run generate",
    "prefix": "bun run generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-start": "^1.168.56",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.577.0",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@inlang/paraglide-js": "^2.25.4",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tanstack/router-cli": "^1.167.38",
    "@types/bun": "1.4.2",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "shadcn": "^4.21.0",
    "steiger": "^0.6.0",
    "typescript": "7.0.2",
    "ultracite": "7.12.0",
    "vite": "^8.3.0"
  },
  "engines": {
    "bun": "1.4.2"
  },
  "packageManager": "bun@1.4.2"
}
